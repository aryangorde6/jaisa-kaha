# Copied to deploy/.env by `make env`, which fills every secret with openssl
# and asks for the admin password without echoing it. Never commit deploy/.env.
SWITCH_REGISTRY=ghcr.io
SWITCH_IMAGE_NAMESPACE=sandbox-quantum
SWITCH_VERSION=0.31.0
COMPOSE_PROJECT_NAME=jaisakaha
COMPOSE_FILE=standalone-docker-compose.yml
COMPOSE_PROFILES=gateway
# Every port stays on this machine. Reach the Gateway over an SSH tunnel, never a public port.
SWITCH_BIND_ADDR=127.0.0.1
GATEWAY_HOST_PORT=3200
API_HOST_PORT=8100
POSTGRES_HOST_PORT=5433
FRONTEND_BASE_URL=http://localhost:3200
GATEWAY_COOKIE_SECURE=false
TELEMETRY_ENABLED=false
# Switch refuses outbound requests to private hosts unless listed here. Keep it empty.
OUTBOUND_ALLOWED_PRIVATE_HOSTS=
DB_USER=switch_app
DB_OWNER_USER=postgres
DB_NAME=switch
GATEWAY_ADMIN_EMAIL=admin@rasoi.local
DB_PASSWORD=
DB_OWNER_PASSWORD=
AGENT_REGISTRATION_TOKEN=
SECRET_KEYS=
GATEWAY_ADMIN_PASSWORD=
