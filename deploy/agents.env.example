# Copy to deploy/agents.env (gitignored). None of these are secrets.
# The Switch room id of #dev for tests, or #diwali-2026 for the family room.
JAISA_ROOM=
# The private S3 bucket for voice notes and transcripts (Mumbai).
JAISA_BUCKET=
# Optional: a Transcribe custom vocabulary (mr-IN) with Mom's corrections.
JAISA_VOCABULARY=
# Switch's sender ids for Aryan's and Mom's Discord accounts (logged by Tape
# and Pothi the first time each one writes; copy them from the log).
JAISA_ARYAN_SENDER=
JAISA_MOM_SENDER=
# The agents' own sender ids: `make senders` prints these lines once each
# agent is registered. Switch's live events don't say a sender is an agent,
# so this is how Tape, Lekhak and Pothi know each other.
JAISA_TAPE_SENDER=
JAISA_LEKHAK_SENDER=
JAISA_POTHI_SENDER=
# The one room make ledger counts: the family room (#diwali-2026), never #dev.
# Tape keeps each tape in a folder per room, so test voice notes never count.
JAISA_LEDGER_ROOM=
# Mom's participant name in the room, for Pothi's questions.
JAISA_MOM_NAME=Mom
